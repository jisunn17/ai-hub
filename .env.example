# === AI Hub Auth: Login Google via Firebase (wajib) ===
# Langkah (≈3 menit, gratis):
# 1. https://console.firebase.google.com → Add project → nama bebas (mis. ai-hub) → Continue (Analytics OFF)
# 2. Build → Authentication → Get started → Sign-in method → Google → Enable → Save
# 3. Authentication → Settings → Authorized domains → Add domain → ai-hub-two-eta.vercel.app
#    (localhost & 127.0.0.1 biasanya sudah otomatis ada untuk dev lokal)
# 4. Gear ⚙ Project settings → General → Your apps → Web (</>) → register "ai-hub-web"
#    → copy blok firebaseConfig → kirim ke DINO (config ini PUBLIK, bukan secret)

# Diisi oleh DINO dari config Firebase lo:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Session signing (jangan diubah sembarangan):
SESSION_SECRET=ganti_dengan_random_64hex   # openssl rand -hex 32
APP_URL=https://ai-hub-two-eta.vercel.app
